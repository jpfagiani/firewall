# Regras para um enlace Ethernet sem VLAN.
# Edite os conjuntos e recarregue o serviço para persistir a política.
table bridge firewall {
    set bloqueados_ipv4 {
        type ipv4_addr
        flags interval
    }

    set bloqueados_ipv6 {
        type ipv6_addr
        flags interval
    }

    chain passagem {
        type filter hook forward priority 0; policy accept;

        meta ibrname "br-firewall" ether type ip ip saddr @bloqueados_ipv4 counter drop
        meta ibrname "br-firewall" ether type ip ip daddr @bloqueados_ipv4 counter drop
        meta ibrname "br-firewall" ether type ip6 ip6 saddr @bloqueados_ipv6 counter drop
        meta ibrname "br-firewall" ether type ip6 ip6 daddr @bloqueados_ipv6 counter drop
        meta ibrname "br-firewall" counter accept
    }
}
